[Unit]
Description=PixWriter autonomous blogging agent (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pixwriter
EnvironmentFile=/home/pixwriter/.pixblog-agent.env
Environment="PATH=/home/pixwriter/.devrelay/node/bin:/usr/bin:/bin"
ExecStart=/home/pixwriter/.devrelay/node/bin/node /home/pixwriter/.devrelay/node/bin/npx tsx /home/pixwriter/agent/src/index.ts
WorkingDirectory=/home/pixwriter/agent
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
